env WRTAG_PATH_FORMAT='albums/{{ .Release.Title | safepath }}/{{ .Track.Position }}{{ .Ext }}'
env WRTAG_ADDON='lyrics lrclib,subproc sh -c "echo following-addon-ran > following-addon"'

exec tag write 'kat_moda/1.flac'
exec tag write 'kat_moda/2.flac'
exec tag write 'kat_moda/3.flac'
exec tag write 'kat_moda/*.flac' musicbrainz_albumid 'e47d04a4-7460-427d-a731-cc82386d85f1'

exec wrtag move -yes kat_moda
stderr 'lyrics provider failed.*lrclib'
stderr 'leaving lyrics unchanged after provider failure'
exists following-addon
cmp following-addon expected-addon
! exists kat_moda
exists 'albums/Kat Moda/1.flac'
exists 'albums/Kat Moda/2.flac'
exists 'albums/Kat Moda/3.flac'
exec tag check 'albums/Kat Moda/*.flac' lyrics

-- expected-addon --
following-addon-ran
